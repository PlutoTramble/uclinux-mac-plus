# Builds GCC 1.42 (../../gcc) for the Mac: cc1 and cpp (cccp) as uClinux
# flat binaries, plus cc1-host and cpp-host for testing at build time.
# Runs inside the build container (see build-in-container.sh).
#
#   make -f gcc.mk SRC=/gcc OUT=/build/build/gcc host     host test copies
#   make -f gcc.mk SRC=/gcc OUT=/build/build/gcc cross    the Mac binaries
#
# GCC 1.42 only works if int, long and pointers are 32 bits wide, so the
# host programs are built with -m32.
#
# The target is gcc/config/tm-uclinux.h (68000, Motorola syntax); the
# machine description is gcc/config/m68k.md.
#
# Generated by LLM

HERE := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
SRC ?= /gcc
OUT ?= /build/build/gcc

# cexp.c and c-parse.tab.c are shipped pre-generated: never run yacc/bison
MAKEFLAGS += -r
.SUFFIXES:

# ---- host (generators and test copies) --------------------------------
HCC     = gcc -m32
HCFLAGS = -O -w -std=gnu89 -fcommon -fgnu89-inline -fwrapv -fno-strict-aliasing

# ---- cross (the Mac) ----------------------------------------------------
CCC      ?= m68k-elf-gcc
CINCS    ?=
CCFLAGS  ?= -m68000 -Os -fomit-frame-pointer -fno-builtin -msep-data -w \
            -Dlinux -D__linux__ -Dunix -D__uClinux__ -DEMBED -D_POSIX_VERSION
CLDFLAGS ?= -Wl,-elf2flt -Wl,-move-rodata
CLDLIBS  ?= -lm -lc

INC = -I$(SRC) -I$(SRC)/config

# cccp.c wants these on the command line; it also needs struct tm
CCCP_FLAGS = -DGCC_INCLUDE_DIR=\"/usr/lib/gcc/include\" \
             -DGPLUSPLUS_INCLUDE_DIR=\"/usr/lib/g++-include\" -include $(HERE)/cccp-compat.h
# host only: the system headers declare sys_errlist differently
HCCCP_FLAGS = $(CCCP_FLAGS) -DBSTRING -include $(HERE)/hostcompat.h

C_OBJS = c-parse.tab c-decl c-typeck c-convert
OBJS = toplev version tree print-tree stor-layout fold-const \
 rtl rtlanal expr stmt expmed explow optabs varasm \
 symout dbxout sdbout emit-rtl insn-emit \
 integrate jump cse loop flow stupid combine \
 regclass local-alloc global-alloc reload reload1 caller-save \
 insn-peep final recog insn-recog insn-extract insn-output
CC1_OBJS = $(C_OBJS) $(OBJS) obstack
CPP_OBJS = cccp cexp version obstack
GENS = genconfig genflags gencodes genemit genrecog genextract genpeep genoutput
GEN_OBJS = rtl obstack

GEN = $(OUT)/gen
HOSTD = $(OUT)/host
CROSSD = $(OUT)/cross

INSN_H = insn-config.h insn-flags.h insn-codes.h
INSN_C = insn-emit.c insn-recog.c insn-extract.c insn-peep.c insn-output.c

all: host cross

host: $(HOSTD)/cc1-host $(HOSTD)/cpp-host
cross: $(CROSSD)/cc1 $(CROSSD)/cpp

# ---- configuration: what `configure' does with symbolic links -----------
# Plain stub files instead of links, so they also work in a bind mount.
$(GEN)/tm.h $(CROSSD)/tm.h:
	@mkdir -p $(dir $@)
	echo '#include "tm-uclinux.h"' > $@

$(GEN)/config.h:
	@mkdir -p $(dir $@)
	echo '#include "xm-i386.h"' > $@

$(CROSSD)/config.h:
	@mkdir -p $(dir $@)
	echo '#include "xm-m68k.h"' > $@

$(GEN)/md: $(SRC)/config/m68k.md
	@mkdir -p $(dir $@)
	cp $< $@

$(GEN)/aux-output.c $(CROSSD)/aux-output.c: $(SRC)/config/out-m68k.c
	@mkdir -p $(dir $@)
	cp $< $@

# ---- generators: always built for the host ------------------------------
$(GEN)/%.o: $(SRC)/%.c $(GEN)/config.h $(GEN)/tm.h
	$(HCC) $(HCFLAGS) -I$(GEN) $(INC) -c $< -o $@

GEN_PROGS = $(addprefix $(GEN)/,$(GENS))
$(GEN_PROGS): $(GEN)/%: $(GEN)/%.o $(GEN)/rtl.o $(GEN)/obstack.o
	$(HCC) $(HCFLAGS) -o $@ $^

$(GEN)/insn-config.h: $(GEN)/genconfig $(GEN)/md
	cd $(GEN) && ./genconfig md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)
$(GEN)/insn-flags.h: $(GEN)/genflags $(GEN)/md
	cd $(GEN) && ./genflags md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)
$(GEN)/insn-codes.h: $(GEN)/gencodes $(GEN)/md
	cd $(GEN) && ./gencodes md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)
$(GEN)/insn-emit.c: $(GEN)/genemit $(GEN)/md
	cd $(GEN) && ./genemit md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)
$(GEN)/insn-recog.c: $(GEN)/genrecog $(GEN)/md
	cd $(GEN) && ./genrecog md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)
$(GEN)/insn-extract.c: $(GEN)/genextract $(GEN)/md
	cd $(GEN) && ./genextract md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)
$(GEN)/insn-peep.c: $(GEN)/genpeep $(GEN)/md
	cd $(GEN) && ./genpeep md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)
$(GEN)/insn-output.c: $(GEN)/genoutput $(GEN)/md
	cd $(GEN) && ./genoutput md > tmp-$(notdir $@) && mv tmp-$(notdir $@) $(notdir $@)

GENERATED = $(addprefix $(GEN)/,$(INSN_H) $(INSN_C)) $(GEN)/aux-output.c

# ---- host cc1-host / cpp-host --------------------------------------------
# config.h and tm.h are found in $(GEN); the insn-* files are in $(GEN) too.
$(HOSTD)/%.o: $(SRC)/%.c $(GENERATED)
	@mkdir -p $(HOSTD)
	$(HCC) $(HCFLAGS) $(EXTRA) -I$(GEN) $(INC) -c $< -o $@

$(HOSTD)/cccp.o: EXTRA = $(HCCCP_FLAGS)
$(CROSSD)/cccp.o: EXTRA = $(CCCP_FLAGS)

$(HOSTD)/hostcompat.o: hostcompat.c
	@mkdir -p $(HOSTD)
	$(HCC) $(HCFLAGS) -c $< -o $@

$(HOSTD)/%.o: $(GEN)/%.c $(GENERATED)
	@mkdir -p $(HOSTD)
	$(HCC) $(HCFLAGS) -I$(GEN) $(INC) -c $< -o $@

$(HOSTD)/cc1-host: $(addprefix $(HOSTD)/,$(addsuffix .o,$(CC1_OBJS)))
	$(HCC) $(HCFLAGS) -o $@ $^

$(HOSTD)/cpp-host: $(addprefix $(HOSTD)/,$(addsuffix .o,$(CPP_OBJS))) $(HOSTD)/hostcompat.o
	$(HCC) $(HCFLAGS) -o $@ $^

# ---- cross cc1 / cpp for the Mac -------------------------------------------
# $(CROSSD) comes first so that its config.h (xm-m68k.h) is used and not the
# host one; the insn-* files do not depend on it.
$(CROSSD)/%.o: $(SRC)/%.c $(GENERATED) $(CROSSD)/config.h $(CROSSD)/tm.h
	$(CCC) $(CCFLAGS) $(EXTRA) -I$(CROSSD) -I$(GEN) $(INC) $(CINCS) -c $< -o $@

$(CROSSD)/%.o: $(GEN)/%.c $(GENERATED) $(CROSSD)/config.h $(CROSSD)/tm.h
	$(CCC) $(CCFLAGS) -I$(CROSSD) -I$(GEN) $(INC) $(CINCS) -c $< -o $@

$(CROSSD)/gcc-compat.o: $(HERE)/gcc-compat.c
	@mkdir -p $(CROSSD)
	$(CCC) $(CCFLAGS) $(CINCS) -c $< -o $@

$(CROSSD)/cc1: $(addprefix $(CROSSD)/,$(addsuffix .o,$(CC1_OBJS))) $(CROSSD)/gcc-compat.o
	$(CCC) $(CCFLAGS) $(CLDFLAGS) -o $@ $^ $(CLDLIBS)

$(CROSSD)/cpp: $(addprefix $(CROSSD)/,$(addsuffix .o,$(CPP_OBJS)))
	$(CCC) $(CCFLAGS) $(CLDFLAGS) -o $@ $^ $(CLDLIBS)

clean:
	rm -rf $(GEN) $(HOSTD) $(CROSSD)

.PRECIOUS: $(GEN)/%.o
.PHONY: all host cross clean
