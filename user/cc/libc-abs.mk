#
# Builds a second copy of the uClinux libc and libm *without* -msep-data
# (plain absolute addressing). Programs that are compiled on the Mac with GCC 1.42
# are linked against these, because GCC 1.42 uses a5 as a normal register.
#
# Used by user/cc/build-libc.sh inside the build container:
#   make -f libc-abs.mk ROOTDIR=<shadow copy of uClinux>
#
# Generated by LLM
#

ifndef ROOTDIR
$(error ROOTDIR must point at the shadow copy of the uClinux tree)
endif

LINUXDIR = linux-2.0.x
LIBCDIR  = libc
UCLINUX_BUILD_LIB = 1
DISABLE_XIP = 1
DISABLE_MOVE_RODATA = 1

include $(ROOTDIR)/.config
include $(ROOTDIR)/$(LINUXDIR)/.config
include $(ROOTDIR)/config/.config
CONFIG_LIBCDIR = libc
include $(ROOTDIR)/config.arch

.EXPORT_ALL_VARIABLES:

all:
	$(MAKE) -C $(ROOTDIR)/lib/libc
	$(MAKE) -C $(ROOTDIR)/lib/libm
